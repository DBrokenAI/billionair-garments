{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "billionaire-garments",
  "main": "src/worker.js",
  "account_id": "692addd767d56d01fcca606b3ff9ab9a",   // the owner's Cloudflare account, so a deploy can never land in someone else's
  "compatibility_date": "2026-10-01",

  // The shop's own address. Cloudflare creates the DNS records and the HTTPS certificate.
  // (www is attached too; each page sends www and plain-http visitors on to https://billionairegarments.com.)
  "routes": [
    { "pattern": "billionairegarments.com", "custom_domain": true },
    { "pattern": "www.billionairegarments.com", "custom_domain": true }
  ],

  // The shop pages. Anything under /api/ (and uploaded photos under /img/) goes to src/worker.js instead.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/img/*"],
    "not_found_handling": "404-page"     // unknown addresses show public/404.html
  },

  // The shop database in the owner's Cloudflare account (created with `npx wrangler d1 create`, see SETUP.md).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "billionaire-garments",
      "database_id": "b5fc3074-b6b3-4bb8-9be7-78caf039bdb0"
    }
  ],

  // Every 10 minutes: put stock back from checkouts that were abandoned.
  "triggers": { "crons": ["*/10 * * * *"] },

  // Secrets (Stripe keys, first dashboard password, email key) are NOT here:
  // they are set with `npx wrangler secret put` or in Cloudflare's website.
  // Shop settings (shipping, tax, policies) are edited by the owner in /admin.

  "observability": { "enabled": true }
}
